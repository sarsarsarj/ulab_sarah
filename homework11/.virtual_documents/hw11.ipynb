# Your code here (WITHOUT NUMPY! or any other modules/libraries/packages)

def orbital_period(a):
    #This function calculates orbital period (T) based on a given semi-major axis value (a)
    T=((a**3)**0.5)
    return T






# Your code here

print(orbital_period(a=0.5))
print(orbital_period(a=1))
print(orbital_period(a=1.5))





