# Your code here
#my function will input an array and spit out the index of the array when the values are
#greater than or equal to 10
def greater_than_ten(arr):
    g=np.where(arr >= 10)[0]
    if len(g)==0: #checks new array of g that is created that holds all of the indexes that
        #are greater than or equal to 10, if the array is empty, it will read this message:
        print("no values greater than or equal to 10 are in this array")
    return g
test_1=np.array([44,8,5,10,4,3,15,0,8,6,10,10,4,12,5,10])
test_2=np.array([1,2,3,4,5,6,7,8,7,6,5,9,2,4,5,1,0,0,8,1])
result=greater_than_ten(test_1)
print(result)





# Your code here
#example 1:shows the indexes where the values are equal to 3
arr = np.array([3,6,1,7,8,2,3,3])
x = np.where(arr == 3)
print(x)

#example 2: indexes where values are even
arr = np.array([2,4,6,7,5,4,1,2,8,10])
x = np.where(arr%2 == 0)
print(x)

#example 3: indexes where values are odd
arr = np.array([3,4,5,6,7,8,3,1,9])
x = np.where(arr%2 == 1)
print(x)





